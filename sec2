<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🛡️ Dashboard Executivo - Segurança</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #000; /* fundo preto */
      color: #fff;
    }
    header {
      text-align: center;
      padding: 20px;
      background: rgba(255,255,255,0.05);
    }
    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      padding: 20px;
    }
    .card {
      background: rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 15px;
      transition: transform 0.2s;
    }
    .card:hover {
      transform: scale(1.05);
      background: rgba(255,255,255,0.15);
    }
    h2 {
      font-size: 1.2em;
      margin-bottom: 10px;
    }
    .kpi {
      display: flex;
      justify-content: space-between;
      margin: 5px 0;
      padding: 5px;
      border-radius: 5px;
    }
    .verde { background: rgba(0,255,0,0.2); }
    .amarelo { background: rgba(255,255,0,0.2); }
    .vermelho { background: rgba(255,0,0,0.2); }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    table, th, td {
      border: 1px solid #fff;
    }
    th, td {
      padding: 8px;
      text-align: left;
    }
    canvas {
      background: rgba(255,255,255,0.05);
      border-radius: 10px;
      padding: 10px;
    }
  </style>
</head>
<body>
  <header>
    <h1>🛡️ Dashboard Executivo - Segurança</h1>
    <p>Período: Jan-Fev 2026 | Data: 05/02/2026</p>
  </header>

  <div class="container">
    <!-- KPIs Estratégicos -->
    <div class="card">
      <h2>📊 KPIs Estratégicos</h2>
      <div class="kpi vermelho"><span>Incidentes Críticos</span><span>3 🔴</span></div>
      <div class="kpi amarelo"><span>MTTD</span><span>4h 🟡</span></div>
      <div class="kpi verde"><span>ISO 27001 Compliance</span><span>92% 🟢</span></div>
      <div class="kpi verde"><span>Disponibilidade Serviços</span><span>99% 🟢</span></div>
    </div>

    <!-- KPIs Operacionais -->
    <div class="card">
      <h2>⚙️ KPIs Operacionais</h2>
      <div class="kpi verde"><span>Phishing Bloqueado</span><span>88% 🟢</span></div>
      <div class="kpi verde"><span>MFA Ativo</span><span>98% 🟢</span></div>
      <div class="kpi verde"><span>Backup Confiável</span><span>95% 🟢</span></div>
      <div class="kpi amarelo"><span>Patch Management</span><span>78% 🟡</span></div>
      <div class="kpi vermelho"><span>Tempo Médio Resposta</span><span>65% 🔴</span></div>
    </div>

    <!-- Governança/Resiliência -->
    <div class="card">
      <h2>🏛️ Governança/Resiliência</h2>
      <div class="kpi verde"><span>Treinamento Segurança</span><span>93% 🟢</span></div>
      <div class="kpi amarelo"><span>Testes de Resiliência</span><span>85% 🟡</span></div>
      <div class="kpi verde"><span>Auditorias Realizadas</span><span>90% 🟢</span></div>
    </div>

    <!-- Tema Específico: Privacidade -->
    <div class="card">
      <h2>🔍 Privacidade</h2>
      <div class="kpi verde"><span>GDPR Compliance</span><span>96% 🟢</span></div>
      <div class="kpi amarelo"><span>Consentimento Usuários</span><span>82% 🟡</span></div>
      <div class="kpi vermelho"><span>Data Breach Reports</span><span>2 🔴</span></div>
    </div>
  </div>

  <!-- Gráficos -->
  <div class="container">
    <div class="card"><canvas id="lineChart"></canvas></div>
    <div class="card"><canvas id="donutChart"></canvas></div>
    <div class="card"><canvas id="radarChart"></canvas></div>
  </div>

  <!-- Top 5 Riscos -->
  <div class="card" style="margin:20px;">
    <h2>⚠️ Top 5 Riscos</h2>
    <table>
      <tr><th>Risco</th><th>Impacto</th><th>Status</th></tr>
      <tr><td>Phishing Avançado</td><td>Alto</td><td>Mitigação em curso</td></tr>
      <tr><td>Ransomware</td><td>Crítico</td><td>Plano de resposta</td></tr>
      <tr><td>Exposição Dados Pessoais</td><td>Alto</td><td>Monitoramento</td></tr>
      <tr><td>Falha em Backup</td><td>Médio</td><td>Correção aplicada</td></tr>
      <tr><td>Insider Threat</td><td>Alto</td><td>Treinamento reforçado</td></tr>
    </table>
  </div>

  <script>
    // Line Chart
    new Chart(document.getElementById('lineChart'), {
      type: 'line',
      data: {
        labels: ['Jan', 'Fev'],
        datasets: [{
          label: 'Incidentes',
          data: [5, 3],
          borderColor: '#00ff00',
          backgroundColor: '#00ff00',
          fill: false
        }]
      },
      options: {
        plugins:{legend:{labels:{color:'#fff'}}},
        scales:{
          x:{ticks:{color:'#fff'}, grid:{color:'rgba(255,255,255,0.2)'}},
          y:{ticks:{color:'#fff'}, grid:{color:'rgba(255,255,255,0.2)'}}
        }
      }
    });

    // Donut Chart
    new Chart(document.getElementById('donutChart'), {
      type: 'doughnut',
      data: {
        labels: ['Verde', 'Amarelo', 'Vermelho'],
        datasets: [{
          data: [9, 3, 2],
          backgroundColor: ['#00ff00','#ffff00','#ff0000']
        }]
      },
      options: { plugins:{legend:{labels:{color:'#fff'}}}}
    });

    // Radar Chart
    new Chart(document.getElementById('radarChart'), {
      type: 'radar',
      data: {
        labels: ['Governança','Operacional','Privacidade','Estratégico'],
        datasets: [{
          label: 'Performance',
          data: [90, 80, 85, 88],
          backgroundColor: 'rgba(0,123,255,0.4)',
          borderColor: '#007bff'
        }]
      },
      options: {
        scales:{
          r:{
            pointLabels:{color:'#fff'},
            angleLines:{color:'rgba(255,255,255,0.2)'},
            grid:{color:'rgba(255,255,255,0.2)'},
            ticks:{color:'#fff'}
          }
        },
        plugins:{legend:{labels:{color:'#fff'}}}
      }
    });
  </script>
</body>
</html>
